{
    "name": "retnly/magento-sync",
    "description": "Official Retnly CRM integration for Magento 2",
    "type": "magento2-module",
    "version": "1.0.0",
    "require": {
        "php": ">=8.1",
        "magento/framework": ">=100.4"
    },
    "autoload": {
        "files": [
            "src/app/code/Retnly/MagentoBridge/registration.php"
        ],
        "psr-4": {
            "Retnly\\MagentoBridge\\": "src/app/code/Retnly/MagentoBridge/"
        }
    },
    "extra": {
        "map": [
            ["src/app/code/Retnly/MagentoBridge", "Retnly/MagentoBridge"]
        ]
    }
}
