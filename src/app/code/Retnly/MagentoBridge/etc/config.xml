<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <zeroslip>
            <general>
                <enabled>0</enabled>
                <api_key/>
                <store_id/>
                <api_base_url>https://test.backend.zeroslip.co/api/v4/magento/</api_base_url>
                <!-- Empty on purpose: the observer falls back to barcode / upc /
                     ean / gtin, which covers almost every merchant with no setup. -->
                <barcode_attribute/>
            </general>
            <pixel>
                <enabled>1</enabled>
                <!-- Push-token registration stays OFF until the Firebase web
                     credentials below are filled in. Event tracking does not
                     need them and runs regardless. -->
                <push_enabled>0</push_enabled>
                <firebase_api_key/>
                <firebase_project_id>zeroslip-2ab49</firebase_project_id>
                <firebase_sender_id/>
                <firebase_app_id/>
                <vapid_key/>
            </pixel>
        </zeroslip>
    </default>
</config>
